{
  "expo": {
    "name": "Handsafe",
    "slug": "handsafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-safety.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.handsafe.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Usamos o Face ID para proteger o acesso e confirmar assinaturas de documentos."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground-safety.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome-safety.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon-safety.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos o Face ID para proteger o acesso e confirmar assinaturas de documentos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E5F5FD",
          "image": "./assets/handsafe-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8912d4b9-7caf-46b9-80ca-e3f9c7a62027"
      }
    }
  }
}
